# Локальная разработка
PORT=3000
BASE_URL=http://localhost:3000
# Пустое значение сохраняет базу и картинки в папке проекта. На Render будет /var/data.
DATA_DIR=

# Discord Developer Portal -> OAuth2 -> Client ID и Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord ID владельца сайта; несколько ID можно указать через запятую
ADMIN_IDS=YOUR_DISCORD_ID

# Длинная случайная строка для подписи сессий
JWT_SECRET=replace-with-a-long-random-secret

# Необязательные параметры для вызова банкира и уведомлений
DISCORD_WEBHOOK_URL=
BANKER_ROLE_ID=
ADMIN_ROLE_ID=
ORDERS_WEBHOOK_URL=